rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if the user owns the resource
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    // Helper function to validate that userId in document matches authenticated user
    function userIdMatches() {
      return request.resource.data.userId == request.auth.uid;
    }
    
    // Rules for notes collection
    match /notes/{noteId} {
      // Allow read if user is authenticated and owns the note
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      
      // Allow create if user is authenticated and sets their own userId
      allow create: if isAuthenticated() && userIdMatches();
      
      // Allow update if user is authenticated and owns the note
      // Also ensure userId cannot be changed
      allow update: if isAuthenticated() 
                    && resource.data.userId == request.auth.uid
                    && request.resource.data.userId == request.auth.uid;
      
      // Allow delete if user is authenticated and owns the note
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }
    
    // Rules for events collection
    match /events/{eventId} {
      // Allow read if user is authenticated and owns the event
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      
      // Allow create if user is authenticated and sets their own userId
      allow create: if isAuthenticated() && userIdMatches();
      
      // Allow update if user is authenticated and owns the event
      allow update: if isAuthenticated() 
                    && resource.data.userId == request.auth.uid
                    && request.resource.data.userId == request.auth.uid;
      
      // Allow delete if user is authenticated and owns the event
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }
    
    // Rules for users collection (user profiles)
    match /users/{userId} {
      // Allow users to read their own profile
      allow read: if isAuthenticated() && request.auth.uid == userId;
      
      // Allow users to create their own profile
      allow create: if isAuthenticated() && request.auth.uid == userId;
      
      // Allow users to update their own profile
      allow update: if isAuthenticated() && request.auth.uid == userId;
      
      // Allow users to delete their own profile
      allow delete: if isAuthenticated() && request.auth.uid == userId;
    }
    
    // Deny all other access by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
